{
  "name": "xeditlib",
  "version": "1.1.0",
  "description": "Bethesda plugin (ESP/ESM/ESL) tools: a cross-platform pure-JS reader and CLI, plus a Node.js FFI wrapper for XEditLib",
  "main": "xelib.js",
  "bin": {
    "xeditlib": "cli.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:native": "node tests/native-diagnostics.cjs"
  },
  "keywords": [
    "xedit",
    "xeditlib",
    "xelib",
    "skyrim",
    "fallout",
    "bethesda",
    "esp",
    "esm",
    "modding",
    "tes5edit",
    "fo4edit",
    "zedit"
  ],
  "author": "WingedGuardian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WingedGuardian/xeditlib.git"
  },
  "homepage": "https://github.com/WingedGuardian/xeditlib#readme",
  "bugs": {
    "url": "https://github.com/WingedGuardian/xeditlib/issues"
  },
  "dependencies": {
    "koffi": "^2.15.1"
  },
  "engines": {
    "node": ">=18.3.0"
  }
}
